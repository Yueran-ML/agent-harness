{
  "name": "inventory-service",
  "version": "2.3.0",
  "server": {
    "host": "0.0.0.0",
    "port": 8443,
    "tls": {
      "enabled": true,
      "cert": "/etc/ssl/inventory.pem"
    }
  },
  "healthcheck": {
    "port": 8080,
    "path": "/health"
  },
  "database": {
    "url": "postgres://db.local:5432/inventory",
    "pool": {
      "min": 2,
      "max": 25
    }
  },
  "cache": {
    "enabled": false,
    "ttl_seconds": 300
  },
  "features": ["search", "export"]
}
