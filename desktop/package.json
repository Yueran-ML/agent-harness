{
  "name": "columbina-desktop",
  "productName": "Columbina",
  "description": "Columbina desktop agent workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "assets:extend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/extend-intro.ps1",
    "predev": "npm run assets:prepare",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run assets:prepare",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File electron/create-icon.ps1 && node electron/package-win.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^41.10.6",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
