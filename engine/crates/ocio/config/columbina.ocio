ocio_profile_version: 2.4
name: columbina
description: |
  The colour spaces of the engine (columbina-ocio) that the built-in ACES Studio config lacks, added to it. Written by catalogue::fragment; do not edit by hand.
roles:
  {}
file_rules:
  - !<Rule> {name: Default, colorspace: F-Log2 F-Gamut}
colorspaces:
  - !<ColorSpace>
    name: Gamma 2.6 Encoded Rec.709
    family: Columbina/Utility
    encoding: sdr-video
    description: "Rec.709, encoded with Gamma 2.6 (a pure power)."
    from_scene_reference: !<GroupTransform>
      children:
        - !<BuiltinTransform> {style: UTILITY - ACES-AP0_to_CIE-XYZ-D65_BFD}
        - !<MatrixTransform> {matrix: [3.2409699419045226, -1.537383177570094, -0.49861076029300344, 0, -0.9692436362808796, 1.8759675015077204, 0.0415550574071756, 0, 0.05563007969699363, -0.2039769588889765, 1.0569715142428784, 0, 0, 0, 0, 1]}
        - !<ExponentTransform> {value: 2.6, style: pass_thru, direction: inverse}

  - !<ColorSpace>
    name: Gamma 2.8 Encoded Rec.709
    family: Columbina/Utility
    encoding: sdr-video
    description: "Rec.709, encoded with Gamma 2.8 (a pure power)."
